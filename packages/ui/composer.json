{
    "name": "timny/rail-ui",
    "description": "A token-driven Blade + Livewire component library for Laravel 13, Livewire 4, Alpine.js 3, and Tailwind CSS 4.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "blade", "livewire", "alpine", "tailwind", "ui-components", "design-system"],
    "homepage": "https://github.com/tim-ny/rail-ui",
    "support": {
        "issues": "https://github.com/tim-ny/rail-ui/issues",
        "source": "https://github.com/tim-ny/rail-ui"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "blade-ui-kit/blade-icons": "^1.6",
        "secondnetwork/blade-tabler-icons": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Rail\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rail\\Ui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rail\\Ui\\UiServiceProvider"
            ]
        }
    }
}
